{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--port", "10005", "--strictPort", "--host", "127.0.0.1"],
      "port": 10005,
      "autoPort": false,

      "env": {
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "100000",
      "DISABLE_COMPACT": "1",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "100000"     
    }
    }
  ]
}
